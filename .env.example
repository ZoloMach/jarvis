# Copie ce fichier en .env puis renseigne ta clé (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle Claude : claude-sonnet-5-5 (rapide, conseillé) ou claude-opus-5-5 (plus intelligent, plus lent)
JARVIS_MODEL=claude-sonnet-5-5
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=Michel

# Écoute. Jarvis se réveille quand on dit son nom en début de phrase (« Jarvis, ouvre Discord »), avec un petit
# Whisper rapide ; « Hey Jarvis » prononcé à l'anglaise marche aussi (openWakeWord).
JARVIS_WAKE_BY_NAME=1
JARVIS_WAKE_WHISPER_MODEL=base
JARVIS_WAKEWORD=hey_jarvis
JARVIS_WAKEWORD_THRESHOLD=0.5
# Double clap (deux claquements de mains) = routine de démarrage ; augmente JARVIS_CLAP_MIN_PEAK s'il se déclenche
# tout seul, baisse-le s'il n'entend pas tes claquements.
JARVIS_CLAP=1
JARVIS_CLAP_MIN_PEAK=2500
# tiny, base, small, medium, large-v3 (plus gros = plus précis mais plus lent ; "medium" si tu as une carte NVIDIA)
JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_DEVICE=cpu
JARVIS_FOLLOWUP_SECONDS=8

# Voix (liste : edge-tts --list-voices | findstr fr-), ou elevenlabs:<identifiant de voix> avec une clé ElevenLabs
JARVIS_VOICE=fr-FR-RemyMultilingualNeural
JARVIS_VOICE_RATE=-8%
JARVIS_VOICE_PITCH=-6Hz
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5

# OBS : Outils > Paramètres du serveur WebSocket
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# Chemin de ffmpeg s'il n'est pas dans le PATH
FFMPEG_PATH=ffmpeg

# Applis fermées par le "mode jeu" (noms de processus séparés par des virgules)
JARVIS_GAME_MODE_CLOSE=OneDrive.exe,Teams.exe

# 1 = ne jamais demander de confirmation avant les actions sensibles (déconseillé)
JARVIS_AUTO_CONFIRM=0
